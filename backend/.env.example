# Use Neon's *unpooled* (direct) connection string here, not the "-pooler" one —
# this backend manages its own connection pool via pg.Pool, so stacking Neon's
# PgBouncer pooler underneath would double-pool for no benefit.
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:5173
PORT=4000
